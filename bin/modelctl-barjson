#!/usr/bin/env bash
# Compact state for the QML bar module: loaded model + every herdr agent.
set -u
PORT="${MODELCTL_PORT:-8090}"
D="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"

active=""
for u in modelctl.service $(systemctl --user list-units --plain --no-legend 'modelctl@*.service' 2>/dev/null | awk '{print $1}'); do
  if systemctl --user is-active --quiet "$u"; then active="$u"; break; fi
done

model=""; state="off"
if [ -n "$active" ]; then
  if curl -sf -m 1 "http://127.0.0.1:$PORT/health" >/dev/null 2>&1; then
    state="ready"
    model=$(curl -sf -m 1 "http://127.0.0.1:$PORT/v1/models" 2>/dev/null \
            | python3 -c 'import sys,json;print(json.load(sys.stdin)["data"][0]["id"])' 2>/dev/null || true)
  else
    state="loading"
  fi
fi
tag=$("$D/modelctl" list --tsv 2>/dev/null | awk -F'\t' -v a="$model" '$2==a{print $3}')
img="off"
if systemctl --user is-active --quiet modelctl@image.service; then img="on"; fi

ST="$HOME/.local/state/modelctl"
sd=$(cat "$ST/sd-model" 2>/dev/null || echo turbo)
sdtag=$("$D/modelctl" sd-list 2>/dev/null | awk -F'|' -v id="$sd" '$1==id{print $9}')
# A generation in flight: model, seconds elapsed, and the sampler's "n/N" if the log has one.
busy=""; if [ -f "$ST/image.busy" ]; then
  IFS=$'\t' read -r bmodel bstart blog bprompt < "$ST/image.busy"
  if [ -f "$blog" ]; then prog=$(tail -c 4000 "$blog" 2>/dev/null | tr '\r' '\n' | grep -oE '[0-9]+/[0-9]+ -' | tail -1 | cut -d' ' -f1); else prog=""; fi
  busy="$bmodel"$'\t'"$(( $(date +%s) - bstart ))"$'\t'"${prog:-}"$'\t'"$bprompt"
fi
freemem=$(free -m | awk '/Mem:/ {printf "%.1f GiB", $7/1024}')

export MC_STATE="$state" MC_MODEL="${model:-}" MC_FREE="$freemem" MC_UNIT="$active" MC_IMG="$img" MC_SD="$sd" MC_SDTAG="${sdtag:-}" MC_TAG="${tag:-}" MC_BUSY="$busy"
"$D/modelctl-agents" 2>/dev/null | python3 -c '
import sys, json, os
agents = []
for line in sys.stdin.read().splitlines():
    if not line.strip():
        continue
    p = (line.split("\t") + [""] * 5)[:5]
    agents.append({"name": p[0], "cwd": p[1], "status": p[2],
                   "focused": p[3] == "1", "pane": p[4]})
print(json.dumps({"state": os.environ.get("MC_STATE", "off"),
                  "model": os.environ.get("MC_MODEL", ""),
                  "tag":   os.environ.get("MC_TAG", ""),
                  "free":  os.environ.get("MC_FREE", ""),
                  "unit":  os.environ.get("MC_UNIT", ""),
                  "image": os.environ.get("MC_IMG", "off") == "on",
                  "sd":    os.environ.get("MC_SD", "turbo"),
                  "sdtag": os.environ.get("MC_SDTAG", ""),
                  "busy":  (lambda b: {"model": b[0], "elapsed": int(b[1] or 0), "progress": b[2], "prompt": b[3]}
                            if b and b[0] else None)((os.environ.get("MC_BUSY", "") + "\t\t\t").split("\t")),
                  "agents": agents}))
'
