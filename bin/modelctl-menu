#!/usr/bin/env bash
# `modelctl-menu` toggles the bar dropdown; `modelctl-menu agents` opens the agents
# submenu in the Omarchy menu (searchable, with the rows synced right now).
set -u
D="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
if [ "${1:-}" = agents ]; then
  "$D/modelctl-menu-sync" --force >/dev/null 2>&1
  exec omarchy menu summon modelctl.agents
fi
exec omarchy shell tjcelaya.modelctl toggle
