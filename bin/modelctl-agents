#!/usr/bin/env bash
# Emit running herdr agents as TSV: agent<TAB>cwd<TAB>status<TAB>focused<TAB>pane_id
# Empty output (exit 0) when herdr isn't running or has no agents.
herdr agent list 2>/dev/null | python3 -c '
import sys,json,os
try: d=json.load(sys.stdin)
except Exception: sys.exit(0)
for a in d.get("result",{}).get("agents",[]) or []:
    cwd=a.get("cwd") or ""
    home=os.path.expanduser("~")
    if cwd.startswith(home): cwd="~"+cwd[len(home):]
    print("\t".join([a.get("agent","?"),cwd,a.get("agent_status",""),
                     "1" if a.get("focused") else "0", a.get("pane_id","")]))
' 2>/dev/null
