#!/usr/bin/env python3
"""Every running interactive coding agent, as TSV:
   agent  cwd  status  focused  id  focus-command  focus-argv(JSON)  stop-argv(JSON)
focus-command is a shell string for the Omarchy menu (which only runs strings);
focus-argv is the same action as an argv array for the bar widget, so nothing
read from herdr or Hyprland is ever re-parsed by a shell. stop-argv ends the
session: the herdr pane is closed, a windowed process gets SIGTERM.

Sources, deduplicated:
  herdr   `herdr --session <name> agent list` for every running herdr session —
          status and pane, focused by raising that session's terminal window and
          then `herdr --session <name> agent focus`
  windows any agent process (claude, opencode, codex, ...) that has a TTY and a
          Hyprland window among its ancestors — a plain foot/alacritty session,
          `omarchy agent`, etc. — focused via a Hyprland dispatch on the window.
          Processes under herdr are skipped here (herdr already reports them);
          headless helpers (daemons, background sessions) have no window and are
          ignored. tmux panes are not walked yet.
Empty output, exit 0, when nothing is running."""
import json, os, re, shlex, subprocess, sys

AGENTS = {"claude", "opencode", "codex", "gemini", "pi", "omp", "crush", "copilot",
          "cursor", "amp", "grok", "kimi", "kilo", "qwen", "droid", "aider"}
HOME = os.path.expanduser("~")


def short(p):
    return "~" + p[len(HOME):] if p.startswith(HOME) else p


def run(cmd):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=3).stdout
    except Exception:
        return ""


rows = []

# ── processes and windows ──
procs = {}
for line in run(["ps", "-eo", "pid=,ppid=,tty=,comm=,args="]).splitlines():
    parts = line.split(None, 4)
    if len(parts) < 4:
        continue
    pid, ppid, tty, comm = parts[:4]
    procs[int(pid)] = (int(ppid), tty, comm, parts[4] if len(parts) > 4 else "")

try:
    clients = [c for c in json.loads(run(["hyprctl", "clients", "-j"])) if c.get("pid", 0) > 0
               and re.fullmatch(r"0x[0-9a-fA-F]+", str(c.get("address", "")))]
    visible_ws = {m.get("activeWorkspace", {}).get("id") for m in json.loads(run(["hyprctl", "monitors", "-j"]))}
except Exception:
    clients, visible_ws = [], set()
# One process can own several windows (a browser, footclient under a foot server),
# so keep every window per pid and focus by window address, never by pid.
windows = {}
for c in clients:
    windows.setdefault(c["pid"], []).append(c)


def rank(w):
    """Prefer a window already on screen, then the one focused most recently."""
    return (0 if w.get("workspace", {}).get("id") in visible_ws else 1, w.get("focusHistoryID", 1 << 30))


def owner_windows(pid):
    """Every Hyprland window of the nearest ancestor of pid that owns any."""
    p = pid
    for _ in range(12):
        if p <= 1 or p not in procs:
            return []
        if p in windows:
            return windows[p]
        p = procs[p][0]
    return []


# Hyprland >= 0.56 takes Lua; older builds take the classic dispatcher. The argv form
# passes the address as a positional parameter so bash never re-tokenizes it.
FOCUS_LUA = 'hyprctl dispatch "hl.dsp.focus({ window = \\"address:$1\\" })" >/dev/null 2>&1 || hyprctl dispatch focuswindow "address:$1"'


def focus_cmd(addr):
    return (f"hyprctl dispatch 'hl.dsp.focus({{ window = \"address:{addr}\" }})' >/dev/null 2>&1"
            f" || hyprctl dispatch focuswindow address:{addr}")


def client_session(args):
    """The herdr session an interactive client process is attached to, else None.
    `herdr` alone attaches the default session; `herdr --session X` and
    `herdr session attach X` name one. --no-session and --remote clients have no
    local session, and any other subcommand is a one-shot CLI call, not a client."""
    toks = args.split()
    if not toks or os.path.basename(toks[0]) != "herdr":
        return None
    session, positional, i = "default", [], 1
    while i < len(toks):
        t = toks[i]
        if t == "--no-session" or t == "--remote" or t.startswith("--remote="):
            return None
        if t == "--session":
            if i + 1 >= len(toks):
                return None
            session, i = toks[i + 1], i + 2
            continue
        if t.startswith("--session="):
            session = t.split("=", 1)[1]
        elif not t.startswith("-"):
            positional.append(t)
        i += 1
    if not positional:
        return session
    if positional[:2] == ["session", "attach"] and len(positional) == 3:
        return positional[2]
    return None


# ── herdr ──
# `herdr agent focus` switches the pane inside herdr but does not raise the terminal
# the client runs in, so from another workspace nothing visible happens. For each
# session, collect the windows of the clients attached to it and raise the best one
# (on screen, else most recently focused) before switching the pane.
session_windows = {}
for pid, (ppid, tty, comm, args) in procs.items():
    if comm != "herdr" or tty == "?":
        continue
    name = client_session(args)
    if name is None:
        continue
    for w in owner_windows(pid):
        if w not in session_windows.setdefault(name, []):
            session_windows[name].append(w)

try:
    sessions = [x["name"] for x in json.loads(run(["herdr", "session", "list", "--json"])).get("sessions", [])
                if x.get("running") and x.get("name")]
except Exception:
    sessions = []
for name in sessions:
    try:
        agents = json.loads(run(["herdr", "--session", name, "agent", "list"])).get("result", {}).get("agents", []) or []
    except Exception:
        continue
    wins = sorted(session_windows.get(name, []), key=rank)
    for a in agents:
        pane = str(a.get("pane_id", ""))
        herdr_focus = f"herdr --session {shlex.quote(name)} agent focus {shlex.quote(pane)}"
        if wins:
            addr = wins[0]["address"]
            cmd = focus_cmd(addr) + "; " + herdr_focus
            argv = ["bash", "-c", FOCUS_LUA + '; herdr --session "$2" agent focus "$3"', "bash", addr, name, pane]
        else:
            cmd = herdr_focus
            argv = ["herdr", "--session", name, "agent", "focus", pane]
        label = pane if len(sessions) == 1 else f"{name}/{pane}"
        rows.append([a.get("agent", "?"), short(a.get("cwd") or ""), a.get("agent_status", ""),
                     "1" if a.get("focused") else "0", label, cmd, json.dumps(argv),
                     json.dumps(["herdr", "--session", name, "pane", "close", pane])])

for pid, (ppid, tty, comm, args) in procs.items():
    if comm not in AGENTS or tty == "?":
        continue
    if any(t in args for t in ("bg-pty-host", "daemon run", "bg-spare", "--bg-", "mcp serve")):
        continue
    wins = []; under_herdr = False; p = ppid
    for _ in range(12):
        if p <= 1 or p not in procs:
            break
        if procs[p][2] == "herdr":
            under_herdr = True; break
        if p in windows:
            wins = windows[p]; break
        p = procs[p][0]
    if under_herdr or not wins:
        continue
    win = min(wins, key=rank)
    try:
        cwd = short(os.readlink(f"/proc/{pid}/cwd"))
    except OSError:
        cwd = ""
    addr = win["address"]   # validated hex by construction; passed as a positional parameter
    rows.append([comm, cwd, "running", "1" if win.get("focusHistoryID") == 0 else "0", f"pid:{pid}",
                 focus_cmd(addr),
                 json.dumps(["bash", "-c", FOCUS_LUA, "bash", addr]),
                 json.dumps(["kill", "-TERM", str(pid)])])

for r in rows:
    print("\t".join(r))
