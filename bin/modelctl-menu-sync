#!/usr/bin/env bash
# Rewrite the agent rows in the Omarchy menu extension; refresh only when the set
# changed. The menu's `provider` mechanism is a closed set hardcoded in Menu.qml,
# so dynamic rows must be written into the JSONC.
set -u
FORCE=0; [ "${1:-}" = "--force" ] && FORCE=1
D="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
EXT="$HOME/.config/omarchy/extensions/omarchy-menu.jsonc"
STATIC="$D/menu-static.jsonc"
STAMP="${XDG_RUNTIME_DIR:-/tmp}/modelctl-agents.stamp"
[ -f "$STATIC" ] || exit 0

rowfile=$(mktemp); "$D/modelctl-agents" > "$rowfile" 2>/dev/null
sig=$(sha256sum < "$rowfile" | cut -d' ' -f1)
if [ $FORCE -eq 0 ] && [ -f "$STAMP" ] && [ "$(cat "$STAMP")" = "$sig" ]; then rm -f "$rowfile"; exit 0; fi

tmp=$(mktemp)
MC_BIN="$D" python3 - "$STATIC" "$tmp" "$rowfile" <<'PY'
import sys,json,os,re
static,out,rowfile=sys.argv[1],sys.argv[2],sys.argv[3]
rows=[l.split("\t") for l in open(rowfile).read().splitlines() if l.strip()]
s=open(static).read().replace("@BIN@", os.environ["MC_BIN"])
import subprocess, shlex
SB=os.environ["MC_BIN"]
shlex_q=shlex.quote
import os
ST=os.path.expanduser("~/.local/state/modelctl")
def conf(k,d=""): return subprocess.run([SB+"/modelctl","conf",k,d],capture_output=True,text=True).stdout.strip()
LAYOUT=conf("menu_layout","headers")            # headers | flat | submenus
if LAYOUT not in ("headers","flat","submenus"): LAYOUT="headers"
J=lambda v: json.dumps(v,ensure_ascii=False)
SEP='  "modelctl.%s": {"icon":"","label":"────────────────","description":"","action":"true"},'
def row(key,label,desc,action,checked=None,icon="",when=None):
    r=f'  {J(key)}: {{"icon":{J(icon)},"label":{J(label)},"description":{J(desc)},"action":{J(action)}'
    if checked is not None: r+=f',"checked":{J(checked)}'
    if when: r+=f',"when":{J(when)}'
    return r+"},"
# Section rows live one dot under their parent: `modelctl.x_id` in a flat card, `modelctl.llm.id`
# inside a submenu. Bullets mark rows under a header; flat layout has no headers, no bullets.
def child(parent,key): return f"{parent}.{key}" if LAYOUT=="submenus" else f"modelctl.{parent.split('.')[-1]}_{key}"
bullet="· " if LAYOUT!="flat" else ""

# ── llama.cpp section: whatever `modelctl list` discovers on disk ──
llm=[]
loaded=subprocess.run(["bash","-c","systemctl --user list-units --plain --no-legend 'modelctl@*.service' | awk '$4==\"running\"{print $1}' | sed 's/^modelctl@//;s/\\.service$//' | head -1"],capture_output=True,text=True).stdout.strip()
mrows=[]
for line in subprocess.run([SB+"/modelctl","list","--tsv"],capture_output=True,text=True).stdout.splitlines():
    mid,label,tag,ctx,note,path,vis=(line.split("\t")+[""]*7)[:7]
    desc=" · ".join(x for x in [f"{int(ctx)//1024}k ctx", "vision" if vis=="1" else "", note] if x)
    mrows.append(row(child("modelctl.llm",re.sub(r"[^A-Za-z0-9_]","_",mid)), bullet+label, desc,
                     f"{SB}/modelctl-switch {mid}", f"systemctl --user is-active --quiet 'modelctl@{mid}.service'"))
if not mrows:
    mrows.append(row(child("modelctl.llm","none"), bullet+"No GGUF models found",
                     "Set MODELCTL_MODEL_DIRS, or pull one with LM Studio or Ollama", "true"))
llm_desc=f"{len(mrows)} model{'s' if len(mrows)!=1 else ''} · " + (f"{loaded} loaded" if loaded else "nothing loaded")
llm_open=not os.path.exists(ST+"/llm-collapsed")
if LAYOUT=="headers":
    llm.append(row("modelctl.llm","llama.cpp",llm_desc,f"{SB}/modelctl-sd toggle-llm","[ ! -e ~/.local/state/modelctl/llm-collapsed ]",icon="󰚩"))
    if llm_open: llm+=mrows
elif LAYOUT=="submenus":
    llm.append(f'  "modelctl.llm": {{"icon":"󰚩","label":"llama.cpp","description":{J(llm_desc)},"aliases":["llm","gguf"]}},')
    llm+=mrows
else:
    llm+=mrows
s=s.replace("// @MODEL_SECTION@","\n".join(llm))

# ── stable-diffusion section: checkpoints discovered under sd_dir ──
sel=(open(ST+"/sd-model").read().strip() if os.path.exists(ST+"/sd-model") else "")
tbl=subprocess.run([SB+"/modelctl-image","--list"],capture_output=True,text=True).stdout
srows=[]
if not tbl.strip():
    srows.append(row(child("modelctl.sd","none"), bullet+"No checkpoints found",
                     "Put .safetensors/.gguf checkpoints (and their VAE / text encoders) under sd_dir in ~/.config/modelctl/models.conf","true"))
for i,line in enumerate(tbl.splitlines()):
    mid,lab,desc,peak,status=(line.split("|")+["ok"])[:5]
    if status!="ok": lab+=" (✗)"      # companions missing; row explains
    elif int(peak)>9000: lab+=" (!)"  # may park the running LLM for the duration
    checked=(f'[ \\"$(cat ~/.local/state/modelctl/sd-model 2>/dev/null)\\" = {shlex_q(mid)} ]' if sel
             else ("true" if i==0 else "false"))   # nothing selected yet → the first (default) row
    srows.append(row(child("modelctl.sd",re.sub(r"[^A-Za-z0-9_]","_",mid)), bullet+lab, desc,
                     f"{SB}/modelctl-sd select {shlex_q(mid)}", checked))
srows.append(row(child("modelctl.sd","server"), bullet+"Keep loaded",
                 "Toggle a resident sd-server · without it each image loads fresh",
                 "systemctl --user is-active --quiet modelctl@image.service && systemctl --user stop modelctl@image.service || systemctl --user start modelctl@image.service",
                 "systemctl --user is-active --quiet modelctl@image.service"))
nsd=len(tbl.splitlines()); selname=(sel or (tbl.splitlines()[0].split("|")[0] if nsd else ""))
sd_desc=f"{nsd} model{'s' if nsd!=1 else ''} · " + (f"{selname} selected · bar 󰋩 generates with it" if selname else "none")
sd_open=not os.path.exists(ST+"/sd-collapsed")
img=[]
if LAYOUT=="headers":
    img.append(row("modelctl.sd","stable-diffusion",sd_desc,f"{SB}/modelctl-sd toggle-expand","[ ! -e ~/.local/state/modelctl/sd-collapsed ]",icon="󰋩"))
    if sd_open: img+=srows
elif LAYOUT=="submenus":
    img.append(f'  "modelctl.sd": {{"icon":"󰋩","label":"stable-diffusion","description":{J(sd_desc)},"aliases":["images","sd"]}},')
    img+=srows
else:
    img.append(SEP % "imgsep"); img+=srows
s=s.replace("// @IMAGE_SECTION@","\n".join(img))
extra=[# Own submenu so the bar badge can summon it directly (`omarchy menu summon modelctl.agents`).
       '  "modelctl.agents": {"icon":"\U000f018d","label":"Agents (%d)","description":"Running coding agents · select one to focus it","aliases":["agents","panes"]},' % len(rows)]
j=lambda v: json.dumps(v, ensure_ascii=False)
if not rows:
    extra.append('  "modelctl.agents.none": {"icon":"","label":"No agents detected","description":"herdr panes and terminal windows running claude, opencode, codex…","action":"true"},')
for i,r in enumerate(rows):
    agent,cwd,status,focused,pane,focus=(r+[""]*6)[:6]
    mark=" ●" if focused=="1" else ""
    # The menu card is a hardcoded 300px, so long cwds truncate. Show the last
    # path segment; the full path stays in the description. Aliases make the
    # top-level search match the agent name and every path segment.
    short=cwd.rstrip("/").split("/")[-1] or cwd
    aliases=[agent,cwd]+[seg for seg in cwd.replace("~","").split("/") if seg]
    extra.append('  "modelctl.agents.%d": {"icon":"\U000f10d2","label":%s,"description":%s,"aliases":%s,"action":%s},'
        % (i, j(f"{agent} · {short}{mark}"), j(f"{cwd} · {status} · {pane}"), j(aliases), j(focus or "true")))
s=s.replace("// @AGENT_ROWS@","\n".join(extra))
import re
# Generated sections end with a comma; tolerate it wherever the section lands.
ours=json.loads(re.sub(r',(\s*[}\]])',r'\1',re.sub(r'^\s*//.*$','',s,flags=re.M)))
# The shell reads ONE user extension file. Keep every entry that is not ours so
# other extensions survive a regeneration; ours are all keyed modelctl*.
ext=os.path.expanduser("~/.config/omarchy/extensions/omarchy-menu.jsonc")
merged={}
try:
    for k,v in json.loads(re.sub(r'^\s*//.*$','',open(ext).read(),flags=re.M)).items():
        if not k.startswith("modelctl"): merged[k]=v
except Exception: pass
merged.update(ours)
open(out,"w").write("// modelctl.* entries are generated by modelctl-menu-sync; other keys are preserved.\n"
                    + json.dumps(merged,indent=2,ensure_ascii=False) + "\n")
PY
if python3 -c "
import json,re,sys
s=open('$tmp').read(); json.loads(re.sub(r'^\s*//.*\$','',s,flags=re.M))" 2>/dev/null; then
  mv "$tmp" "$EXT"; printf '%s' "$sig" > "$STAMP"; omarchy menu refresh >/dev/null 2>&1
else rm -f "$tmp"; fi
rm -f "$rowfile"
