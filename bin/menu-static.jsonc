{
  // modelctl — local model server (llama.cpp on :8090).
  // Opened by the 󰚩 bar widget. Separate from Omarchy's agents widget (Claude usage).
  "modelctl": {
    "icon": "󰚩",
    "label": "Local models",
    "aliases": ["models"],
    "description": "Load a local GGUF model for opencode"
  },

  "modelctl.default": {
    "icon": "",
    "label": "gpt-oss-20b",
    "description": "131k ctx · fastest · the default · 13.7 GiB free",
    "action": "~/.config/omarchy/bar/scripts/modelctl-switch default",
    "checked": "systemctl --user is-active --quiet modelctl@default.service || systemctl --user is-active --quiet modelctl.service"
  },
  "modelctl.big": {
    "icon": "",
    "label": "qwen3-coder-30b",
    "description": "16k ctx · 2.5x slower · batch coding only · 8.7 GiB free",
    "action": "~/.config/omarchy/bar/scripts/modelctl-switch big",
    "checked": "systemctl --user is-active --quiet modelctl@big.service"
  },
  "modelctl.vision": {
    "icon": "",
    "label": "gemma-4-12B (vision)",
    "description": "16k ctx · accepts images · ~35s per image query",
    "action": "~/.config/omarchy/bar/scripts/modelctl-switch vision",
    "checked": "systemctl --user is-active --quiet modelctl@vision.service"
  },
  "modelctl.fast": {
    "icon": "",
    "label": "qwen3-4b",
    "description": "32k ctx · 29 tok/s · quick chat / smoke test",
    "action": "~/.config/omarchy/bar/scripts/modelctl-switch fast",
    "checked": "systemctl --user is-active --quiet modelctl@fast.service"
  },

"modelctl.image": {
    "icon": "",
    "label": "SD-Turbo (images)",
    "description": "Resident on :8091 · +4.5 GiB · coexists with an LLM",
    "action": "systemctl --user start modelctl@image.service",
    "checked": "systemctl --user is-active --quiet modelctl@image.service"
  },
  "modelctl.generate": {
    "icon": "󰋩",
    "label": "Generate image (Turbo)…",
    "description": "4 steps · ~9s · fast drafts",
    "action": "~/.config/omarchy/bar/scripts/modelctl-image --turbo"
  },
  "modelctl.generate15": {
    "icon": "󰋩",
    "label": "Generate image (SD 1.5)…",
    "description": "20 steps · slower · responds to guidance, steers harder",
    "action": "~/.config/omarchy/bar/scripts/modelctl-image --sd15"
  },
  "modelctl.sep": {
    "icon": "",
    "label": "────────────────",
    "description": "",
    "action": "true"
  },

  "modelctl.stop": {
    "icon": "",
    "label": "Stop server",
    "description": "Release the GPU pool",
    "action": "~/.config/omarchy/bar/scripts/modelctl-stop",
    "when": "systemctl --user is-active --quiet modelctl.service || systemctl --user list-units --plain --no-legend 'modelctl@*.service' | grep -q active"
  },
  "modelctl.lmstudio": {
    "icon": "",
    "label": "Open LM Studio",
    "description": "Browse and download GGUF models",
    "action": "uwsm-app -- lm-studio"
  }
}
