#!/usr/bin/env bash
# Switch the resident model: stop whatever modelctl@ unit is running, start this one.
# Usage: modelctl-switch <model-id>   (ids: modelctl list)
set -u
D="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
ID="${1:?model id}"
for u in modelctl.service $(systemctl --user list-units --plain --no-legend 'modelctl@*.service' 2>/dev/null | awk '{print $1}'); do
  systemctl --user stop "$u" 2>/dev/null
done
# The alias llama-server reports (-a). A client that caches per-model limits
# (opencode ignores the request's model field) must be pointed at the same name.
ALIAS=$("$D/modelctl" list --tsv 2>/dev/null | awk -F'\t' -v id="$ID" '$1==id{print $2}')
notify-send -a modelctl -i computer "Loading ${ALIAS:-$ID}…" "Cold start can take a while.\nIn opencode: /models -> ${ALIAS:-$ID}"
systemctl --user start "modelctl@${ID}.service"
