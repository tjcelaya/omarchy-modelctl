#!/usr/bin/env python3
"""modelctl — launch a local GGUF model with llama-server, discovered from disk.

  modelctl                 start the default model (models.conf [defaults] default=, else first)
  modelctl <id>            start that model            (id = GGUF filename without .gguf)
  modelctl list            table of discovered models
  modelctl list --tsv      id, label, tag, ctx, description, path, vision  (for scripts)
  modelctl image           resident sd-server (see MODELCTL_SD_DIR)
  modelctl show <id>       the exact llama-server command line, without running it
  modelctl conf <key> [default]   print a [defaults] value from models.conf (for the shell scripts)
  modelctl sd-list         image models: id|label|note|peak|steps|cfg|res|args|tag|status|family
  modelctl sd-args <id>    that model's sd-cli argv, NUL-separated (never word-split a path)

Models are found under model_dirs from models.conf [defaults] (colon-separated; default
~/.lmstudio/models:~/.cache/llama.cpp:~/models:~/.ollama/models), recursively,
following symlinks. `mmproj-*.gguf` files are never models: one sitting next to
a model is attached as its vision projector. Sharded models are launched from
shard 1. An Ollama store is recognised by its manifests/ folder: each pulled
model (name:tag) is served straight from its GGUF blob, projector included —
Ollama itself is not involved and need not be running.

Everything tunable is in ~/.config/modelctl/models.conf (INI). Nothing about a
specific machine or model lives in this file. Example: models.conf.example.

Image models are discovered the same way: every checkpoint under sd_dir is
classified by family (SD 1.x, SD-Turbo, SDXL, SDXL-Lightning, Flux schnell/dev,
Chroma, Z-Image, SD3) and paired with the VAE / text encoders that family needs,
found in the same folder. [sd:<glob>] sections in models.conf overlay label, tag,
note, peak, steps, cfg, res, extra (appended flags) or args (full replacement);
a section that matches no file but has args= is a fully declared entry.
"""
import configparser, fnmatch, json, os, re, shlex, sys

HOME = os.path.expanduser("~")
CONF = os.environ.get("MODELCTL_CONF", f"{HOME}/.config/modelctl/models.conf")
DEFAULT_DIRS = f"{HOME}/.lmstudio/models:{HOME}/.cache/llama.cpp:{HOME}/models:{HOME}/.ollama/models"
# Filled from [defaults] by load_conf(); the MODELCTL_* environment still wins.
DIRS = DEFAULT_DIRS.split(":")
PORT = "8090"
# Sane, hardware-agnostic defaults. Full GPU offload, flash attention, one slot
# with prefix caching (agent prompts are re-sent every turn), --jinja because a
# few templates (gemma-4) refuse to run without it.
DEFAULT_ARGS = "-ngl 99 -fa on -np 1 --cache-reuse 256 --jinja"
DEFAULT_CTX = 16384
QUANT_RE = re.compile(r"[-_.](?:I?Q\d[_A-Za-z0-9]*|MXFP4|BF16|F16|F32|UD-[A-Z0-9_]+)$", re.I)
SHARD_RE = re.compile(r"-(\d{5})-of-\d{5}$")


def load_conf():
    global DIRS, PORT
    cp = configparser.ConfigParser(interpolation=None)
    cp.optionxform = str
    if os.path.exists(CONF):
        cp.read(CONF)
    dirs = os.environ.get("MODELCTL_MODEL_DIRS") or cp.get("defaults", "model_dirs", fallback=DEFAULT_DIRS)
    DIRS = [os.path.expanduser(d) for d in dirs.split(":") if d]
    PORT = os.environ.get("MODELCTL_PORT") or cp.get("defaults", "port", fallback="8090")
    return cp


def sd_port(cp):
    return os.environ.get("MODELCTL_SD_PORT") or cp.get("defaults", "sd_port", fallback="8091")


def conf_for(cp, mid):
    """[defaults] overlaid with every section whose name (a glob) matches the id."""
    d = dict(cp["defaults"]) if cp.has_section("defaults") else {}
    for sec in cp.sections():
        if sec != "defaults" and fnmatch.fnmatchcase(mid, sec):
            d.update(cp[sec])
    return d


def ollama_models(root):
    """Yield (id, label, gguf-path, mmproj-path) for every manifest in an Ollama store."""
    man = os.path.join(root, "manifests")
    for dp, _, files in os.walk(man, followlinks=True):
        for tag in files:
            try:
                d = json.load(open(os.path.join(dp, tag)))
            except Exception:
                continue
            model = proj = ""
            for layer in d.get("layers", []):
                blob = os.path.join(root, "blobs", layer.get("digest", "").replace(":", "-"))
                if layer.get("mediaType", "").endswith(".model"):
                    model = blob
                elif layer.get("mediaType", "").endswith(".projector"):
                    proj = blob
            if not model:
                continue
            # manifests/<registry>/<namespace>/<name>/<tag>; library/ is the implicit namespace
            parts = os.path.relpath(dp, man).split(os.sep)
            name = "/".join(p for p in parts[1:] if p != "library") or parts[-1]
            yield f"{name}:{tag}", model, proj


def discover(cp):
    hide = [h for h in (cp.get("defaults", "hide", fallback="")).split() if h]
    seen, models = set(), []

    def add(mid, stem, path, dp, mmproj_default, label_default=None):
        mid = re.sub(r"[^A-Za-z0-9._:-]", "_", mid)
        if mid in seen or any(fnmatch.fnmatchcase(mid, h) for h in hide):
            return
        seen.add(mid)
        c = conf_for(cp, mid)
        mmproj = os.path.expanduser(c["mmproj"]) if c.get("mmproj") else mmproj_default
        models.append({
            "id": mid, "path": path,
            "label": c.get("label") or label_default or QUANT_RE.sub("", stem),
            "tag": c.get("tag", ""), "ctx": int(c.get("ctx", DEFAULT_CTX)),
            "note": c.get("note", ""), "args": c.get("args", DEFAULT_ARGS),
            "extra": c.get("extra", ""), "mmproj": mmproj,
        })

    for root in DIRS:
        root = os.path.expanduser(root)
        if not os.path.isdir(root):
            continue
        if os.path.isdir(os.path.join(root, "manifests")):      # Ollama store
            for name, path, proj in ollama_models(root):
                add(name, name, path, root, proj, label_default=name)
            continue
        for dp, _, files in os.walk(root, followlinks=True):
            for f in sorted(files):
                if not f.endswith(".gguf") or f.startswith("mmproj"):
                    continue
                stem = f[:-5]
                m = SHARD_RE.search(stem)
                if m:
                    if m.group(1) != "00001":
                        continue
                    stem = stem[:m.start()]
                mmproj = next((os.path.join(dp, g) for g in sorted(os.listdir(dp))
                               if g.startswith("mmproj") and g.endswith(".gguf")), "")
                add(stem, stem, os.path.join(dp, f), dp, mmproj)
    models.sort(key=lambda m: m["label"].lower())
    default = cp.get("defaults", "default", fallback="")
    if default:
        models.sort(key=lambda m: 0 if fnmatch.fnmatchcase(m["id"], default) else 1)
    return models


# ── image models ──────────────────────────────────────────────────────────────
SD_EXT = (".safetensors", ".gguf")   # no .ckpt: pickle containers, nothing on this stack needs them
# Files that are never a model on their own: VAEs, text encoders, projectors.
SD_COMPANION = re.compile(r"(^|[-_.])(ae|vae|t5|t5xxl|clip|clip_l|clip_g|qwen[0-9]*|llm|encoder|mmproj|umt5)([-_.]|$)", re.I)
# Family by filename, first match wins. Everything unmatched is treated as SD 1.x.
SD_FAMILY_RE = [
    (r"chroma", "chroma"), (r"z[-_]?image", "zimage"),
    (r"flux.*schnell|schnell", "flux-schnell"), (r"flux", "flux-dev"),
    (r"(sdxl|sd_xl|xl).*(lightning|turbo)|(lightning|turbo).*(sdxl|sd_xl)", "sdxl-lightning"),
    (r"sdxl|sd_xl", "sdxl"), (r"sd[-_]?turbo", "sd-turbo"),
    (r"sd3|stable[-_]?diffusion[-_]?3", "sd3"),
]
# Per family: bar tag, sampler defaults, how the checkpoint is passed, which companions
# it needs (name -> filename regex) and which are optional. Flags are sd-cli's; nothing
# here is a measurement.
SD_FAMILY = {
    "sd15":           dict(tag="sd15", steps=20, cfg=7.0, res=512,  load="-m", flags="--type f16", needs={}, opt={}),
    "sd-turbo":       dict(tag="turbo", steps=4,  cfg=1.0, res=512,  load="-m", flags="--type f16", needs={}, opt={}),
    "sdxl":           dict(tag="sdxl", steps=20, cfg=7.0, res=1024, load="-m", flags="--diffusion-fa --vae-tiling", needs={},
                           opt={"vae": r"sdxl.*vae|vae.*(sdxl|xl)"}),
    "sdxl-lightning": dict(tag="sdxl", steps=4,  cfg=1.0, res=1024, load="-m",
                           flags="--sampling-method euler --scheduler sgm_uniform --diffusion-fa --vae-tiling",
                           needs={}, opt={"vae": r"sdxl.*vae|vae.*(sdxl|xl)"}),
    "flux-schnell":   dict(tag="flux", steps=4,  cfg=1.0, res=1024, load="--diffusion-model", flags="--diffusion-fa --vae-tiling",
                           needs={"vae": r"^(flux_)?ae\b|flux.*ae", "t5xxl": r"t5.*xxl|t5xxl", "clip_l": r"clip_l"}, opt={}),
    "flux-dev":       dict(tag="flux", steps=20, cfg=1.0, res=1024, load="--diffusion-model", flags="--diffusion-fa --vae-tiling",
                           needs={"vae": r"^(flux_)?ae\b|flux.*ae", "t5xxl": r"t5.*xxl|t5xxl", "clip_l": r"clip_l"}, opt={}),
    "chroma":         dict(tag="chrm", steps=20, cfg=4.0, res=1024, load="--diffusion-model",
                           flags="--sampling-method euler --diffusion-fa --vae-tiling",
                           needs={"vae": r"^(flux_)?ae\b|flux.*ae", "t5xxl": r"t5.*xxl|t5xxl"}, opt={}),
    "zimage":         dict(tag="zimg", steps=8,  cfg=1.0, res=1024, load="--diffusion-model", flags="--diffusion-fa --vae-tiling",
                           needs={"vae": r"^(flux_)?ae\b|flux.*ae", "llm": r"qwen3.*4b|qwen"}, opt={}),
    "sd3":            dict(tag="sd3", steps=28, cfg=4.5, res=1024, load="-m", flags="--vae-tiling",
                           needs={"clip_l": r"clip_l", "clip_g": r"clip_g", "t5xxl": r"t5.*xxl|t5xxl"}, opt={}),
}
SD_TAG_RE = re.compile(r"[^a-z0-9]")


def sd_dir(cp):
    return os.path.expanduser(os.environ.get("MODELCTL_SD_DIR")
                              or cp.get("defaults", "sd_dir", fallback=f"{HOME}/.local/share/stable-diffusion/models"))


def sd_family(stem):
    low = stem.lower()
    for rx, fam in SD_FAMILY_RE:
        if re.search(rx, low):
            return fam
    return "sd15"


def sd_discover(cp):
    """Every checkpoint under sd_dir, classified, with companions resolved and
    [sd:<glob>] overlays applied; then any declared-only sections."""
    root = sd_dir(cp)
    files = []
    if os.path.isdir(root):
        for dp, _, fs in os.walk(root, followlinks=True):
            for f in sorted(fs):
                if f.endswith(SD_EXT):
                    files.append(os.path.join(dp, f))
    companions = [f for f in files if SD_COMPANION.search(os.path.basename(f))]
    checkpoints = [f for f in files if f not in companions]

    def pick(rx):
        hits = [c for c in companions if re.search(rx, os.path.basename(c), re.I)]
        return sorted(hits, key=lambda c: (-os.path.getsize(c), c))[0] if hits else ""

    hide = [h for h in cp.get("defaults", "sd_hide", fallback="").split() if h]
    seen, models = set(), []
    for path in checkpoints:
        stem = os.path.basename(path).rsplit(".", 1)[0]
        mid = re.sub(r"[^A-Za-z0-9._:-]", "_", stem)
        if mid in seen or any(fnmatch.fnmatchcase(mid, h) for h in hide):
            continue
        seen.add(mid)
        fam = sd_family(stem); F = SD_FAMILY[fam]
        parts, missing, size = [F["load"], path], [], os.path.getsize(path)
        for name, rx in F["needs"].items():
            c = pick(rx)
            if c: parts += [f"--{name}", c]; size += os.path.getsize(c)
            else: missing.append(name)
        for name, rx in F["opt"].items():
            c = pick(rx)
            if c: parts += [f"--{name}", c]; size += os.path.getsize(c)
        flags = F["flags"]
        if F["load"] == "-m" and not path.endswith(".safetensors"):
            flags = flags.replace("--type f16", "").strip()
        # Nominal peak: the weights plus activation headroom that grows with the canvas.
        # Only for deciding whether to park the LLM; a `--check --full` replaces it.
        peak = int(size / 1048576 + (F["res"] / 512) ** 2 * 400)
        c = {}
        for sec in cp.sections():
            if sec.startswith("sd:") and fnmatch.fnmatchcase(mid, sec[3:].strip()):
                c.update(cp[sec])
        if c.get("hide", "").lower() in ("1", "true", "yes"):
            continue
        args = c["args"].replace("$SD", root) if c.get("args") else shlex.join(parts) + " " + flags
        if c.get("extra"): args += " " + c["extra"].replace("$SD", root)
        label = c.get("label") or QUANT_RE.sub("", stem)
        models.append({
            "id": mid, "label": label, "family": fam, "peak": c.get("peak", str(peak)),
            "steps": c.get("steps", str(F["steps"])), "cfg": c.get("cfg", str(F["cfg"])), "res": c.get("res", str(F["res"])),
            "note": c.get("note") or f"{fam} · {c.get('res', F['res'])}² · {c.get('steps', F['steps'])} steps",
            "args": args, "tag": c.get("tag") or F["tag"],
            "status": "ok" if (c.get("args") or not missing) else "missing " + ",".join(missing),
        })
    # Declared-only sections: a name that is not a glob over any file, with args=.
    for sec in cp.sections():
        if not sec.startswith("sd:"):
            continue
        mid = sec[3:].strip(); c = cp[sec]
        if not c.get("args") or any(fnmatch.fnmatchcase(m["id"], mid) for m in models) or mid in seen:
            continue
        seen.add(mid)
        models.append({"id": mid, "label": c.get("label", mid), "family": c.get("family", "declared"),
                       "peak": c.get("peak", "8000"), "steps": c.get("steps", "20"), "cfg": c.get("cfg", "7.0"),
                       "res": c.get("res", "512"), "note": c.get("note", ""), "args": c["args"].replace("$SD", root),
                       "tag": c.get("tag") or SD_TAG_RE.sub("", mid.lower())[:5], "status": "ok"})
    models.sort(key=lambda m: (m["status"] != "ok", m["label"].lower()))
    return models


def find(models, key):
    for m in models:
        if m["id"] == key or m["label"] == key:
            return m
    hits = [m for m in models if fnmatch.fnmatchcase(m["id"], key) or key.lower() in m["id"].lower()]
    if len(hits) == 1:
        return hits[0]
    sys.exit(f"modelctl: {'ambiguous' if hits else 'unknown'} model '{key}'"
             + (": " + ", ".join(h["id"] for h in hits) if hits else " (see: modelctl list)"))


def cmdline(m):
    cmd = ["llama-server", "-m", m["path"], "-c", str(m["ctx"]), "-a", m["label"],
           "--host", "127.0.0.1", "--port", PORT] + shlex.split(m["args"]) + shlex.split(m["extra"])
    if m["mmproj"]:
        cmd += ["--mmproj", m["mmproj"]]
    return cmd


def main(argv):
    cp = load_conf()
    cmd = argv[0] if argv else "default"
    if cmd == "conf":
        # Shell helpers read their settings through here so the INI stays the one source.
        v = cp.get("defaults", argv[1], fallback=argv[2] if len(argv) > 2 else "")
        print(os.path.expanduser(v)); return
    if cmd == "sd-list":
        for m in sd_discover(cp):
            print("|".join([m["id"], m["label"], m["note"], m["peak"], m["steps"], m["cfg"], m["res"], m["args"],
                            m["tag"], m["status"], m["family"]]))
        return
    if cmd == "sd-args":
        m = next((m for m in sd_discover(cp) if m["id"] == argv[1]), None)
        if not m:
            sys.exit(f"modelctl: unknown image model '{argv[1]}'")
        sys.stdout.write("\0".join(shlex.split(m["args"])) + "\0")
        return
    if cmd == "image":
        sd = sd_dir(cp)
        ck = cp.get("defaults", "sd_server_model", fallback="sd_turbo.safetensors")
        os.execvp("sd-server", ["sd-server", "-m", os.path.join(sd, ck), "--type", "f16",
                                "--listen-ip", "127.0.0.1", "--listen-port", sd_port(cp)] + argv[1:])
    models = discover(cp)
    if cmd == "list":
        if not models:
            sys.exit("modelctl: no .gguf files under " + ":".join(DIRS) + " (set model_dirs under [defaults] in " + CONF + ")")
        if "--tsv" in argv:
            for m in models:
                print("\t".join([m["id"], m["label"], m["tag"], str(m["ctx"]), m["note"], m["path"],
                                 "1" if m["mmproj"] else "0"]))
            return
        print(f"{'ID':40} {'CTX':>7}  {'VIS':3} NOTE")
        for m in models:
            print(f"{m['id']:40} {m['ctx']:>7}  {'yes' if m['mmproj'] else '':3} {m['note']}")
        print(f"\nconfig: {CONF}   port: {PORT}   dirs: {':'.join(DIRS)}")
        return
    if cmd in ("-h", "--help", "help"):
        print(__doc__.strip()); return
    if cmd == "show":
        print(shlex.join(cmdline(models[0] if argv[1:2] in ([], ["default"]) else find(models, argv[1]))))
        return
    if not models:
        sys.exit("modelctl: no models found (see: modelctl list)")
    m = models[0] if cmd == "default" else find(models, cmd)
    if not os.path.exists(m["path"]):
        sys.exit(f"modelctl: {m['path']} vanished — is the model partition mounted?")
    c = cmdline(m) + argv[1:]
    print("modelctl:", shlex.join(c), file=sys.stderr, flush=True)
    os.execvp(c[0], c)


if __name__ == "__main__":
    main(sys.argv[1:])
