#!/usr/bin/env python3
"""modelctl — launch a local GGUF model with llama-server, discovered from disk.

  modelctl                 start the default model (models.conf [defaults] default=, else first)
  modelctl <id>            start that model            (id = GGUF filename without .gguf)
  modelctl list            table of discovered models
  modelctl list --tsv      id, label, tag, ctx, description, path, vision  (for scripts)
  modelctl image           resident sd-server (see MODELCTL_SD_DIR)
  modelctl show <id>       the exact llama-server command line, without running it
  modelctl conf <key> [default]   print a [defaults] value from models.conf (for the shell scripts)
  modelctl sd-list         image models from the [sd:<id>] sections, as id|label|note|peak|steps|cfg|res|args

Models are found under MODELCTL_MODEL_DIRS (colon-separated; default
~/.lmstudio/models:~/.cache/llama.cpp:~/models:~/.ollama/models), recursively,
following symlinks. `mmproj-*.gguf` files are never models: one sitting next to
a model is attached as its vision projector. Sharded models are launched from
shard 1. An Ollama store is recognised by its manifests/ folder: each pulled
model (name:tag) is served straight from its GGUF blob, projector included —
Ollama itself is not involved and need not be running.

Everything tunable is in ~/.config/modelctl/models.conf (INI). Nothing about a
specific machine or model lives in this file. Example: models.conf.example.

Image models are not discovered: each is an [sd:<id>] section (label, note, peak,
steps, cfg, res, args; `$SD` in args expands to sd_dir).
"""
import configparser, fnmatch, json, os, re, shlex, sys

HOME = os.path.expanduser("~")
CONF = os.environ.get("MODELCTL_CONF", f"{HOME}/.config/modelctl/models.conf")
DIRS = os.environ.get("MODELCTL_MODEL_DIRS",
                      f"{HOME}/.lmstudio/models:{HOME}/.cache/llama.cpp:{HOME}/models:{HOME}/.ollama/models").split(":")
PORT = os.environ.get("MODELCTL_PORT", "8090")
# Sane, hardware-agnostic defaults. Full GPU offload, flash attention, one slot
# with prefix caching (agent prompts are re-sent every turn), --jinja because a
# few templates (gemma-4) refuse to run without it.
DEFAULT_ARGS = "-ngl 99 -fa on -np 1 --cache-reuse 256 --jinja"
DEFAULT_CTX = 16384
QUANT_RE = re.compile(r"[-_.](?:I?Q\d[_A-Za-z0-9]*|MXFP4|BF16|F16|F32|UD-[A-Z0-9_]+)$", re.I)
SHARD_RE = re.compile(r"-(\d{5})-of-\d{5}$")


def load_conf():
    cp = configparser.ConfigParser(interpolation=None)
    cp.optionxform = str
    if os.path.exists(CONF):
        cp.read(CONF)
    return cp


def conf_for(cp, mid):
    """[defaults] overlaid with every section whose name (a glob) matches the id."""
    d = dict(cp["defaults"]) if cp.has_section("defaults") else {}
    for sec in cp.sections():
        if sec != "defaults" and fnmatch.fnmatchcase(mid, sec):
            d.update(cp[sec])
    return d


def ollama_models(root):
    """Yield (id, label, gguf-path, mmproj-path) for every manifest in an Ollama store."""
    man = os.path.join(root, "manifests")
    for dp, _, files in os.walk(man, followlinks=True):
        for tag in files:
            try:
                d = json.load(open(os.path.join(dp, tag)))
            except Exception:
                continue
            model = proj = ""
            for layer in d.get("layers", []):
                blob = os.path.join(root, "blobs", layer.get("digest", "").replace(":", "-"))
                if layer.get("mediaType", "").endswith(".model"):
                    model = blob
                elif layer.get("mediaType", "").endswith(".projector"):
                    proj = blob
            if not model:
                continue
            # manifests/<registry>/<namespace>/<name>/<tag>; library/ is the implicit namespace
            parts = os.path.relpath(dp, man).split(os.sep)
            name = "/".join(p for p in parts[1:] if p != "library") or parts[-1]
            yield f"{name}:{tag}", model, proj


def discover(cp):
    hide = [h for h in (cp.get("defaults", "hide", fallback="")).split() if h]
    seen, models = set(), []

    def add(mid, stem, path, dp, mmproj_default, label_default=None):
        mid = re.sub(r"[^A-Za-z0-9._:-]", "_", mid)
        if mid in seen or any(fnmatch.fnmatchcase(mid, h) for h in hide):
            return
        seen.add(mid)
        c = conf_for(cp, mid)
        mmproj = os.path.expanduser(c["mmproj"]) if c.get("mmproj") else mmproj_default
        models.append({
            "id": mid, "path": path,
            "label": c.get("label") or label_default or QUANT_RE.sub("", stem),
            "tag": c.get("tag", ""), "ctx": int(c.get("ctx", DEFAULT_CTX)),
            "note": c.get("note", ""), "args": c.get("args", DEFAULT_ARGS),
            "extra": c.get("extra", ""), "mmproj": mmproj,
        })

    for root in DIRS:
        root = os.path.expanduser(root)
        if not os.path.isdir(root):
            continue
        if os.path.isdir(os.path.join(root, "manifests")):      # Ollama store
            for name, path, proj in ollama_models(root):
                add(name, name, path, root, proj, label_default=name)
            continue
        for dp, _, files in os.walk(root, followlinks=True):
            for f in sorted(files):
                if not f.endswith(".gguf") or f.startswith("mmproj"):
                    continue
                stem = f[:-5]
                m = SHARD_RE.search(stem)
                if m:
                    if m.group(1) != "00001":
                        continue
                    stem = stem[:m.start()]
                mmproj = next((os.path.join(dp, g) for g in sorted(os.listdir(dp))
                               if g.startswith("mmproj") and g.endswith(".gguf")), "")
                add(stem, stem, os.path.join(dp, f), dp, mmproj)
    models.sort(key=lambda m: m["label"].lower())
    default = cp.get("defaults", "default", fallback="")
    if default:
        models.sort(key=lambda m: 0 if fnmatch.fnmatchcase(m["id"], default) else 1)
    return models


def find(models, key):
    for m in models:
        if m["id"] == key or m["label"] == key:
            return m
    hits = [m for m in models if fnmatch.fnmatchcase(m["id"], key) or key.lower() in m["id"].lower()]
    if len(hits) == 1:
        return hits[0]
    sys.exit(f"modelctl: {'ambiguous' if hits else 'unknown'} model '{key}'"
             + (": " + ", ".join(h["id"] for h in hits) if hits else " (see: modelctl list)"))


def cmdline(m):
    cmd = ["llama-server", "-m", m["path"], "-c", str(m["ctx"]), "-a", m["label"],
           "--host", "127.0.0.1", "--port", PORT] + shlex.split(m["args"]) + shlex.split(m["extra"])
    if m["mmproj"]:
        cmd += ["--mmproj", m["mmproj"]]
    return cmd


def main(argv):
    cp = load_conf()
    cmd = argv[0] if argv else "default"
    if cmd == "conf":
        # Shell helpers read their settings through here so the INI stays the one source.
        v = cp.get("defaults", argv[1], fallback=argv[2] if len(argv) > 2 else "")
        print(os.path.expanduser(v)); return
    if cmd == "sd-list":
        sd = os.path.expanduser(os.environ.get("MODELCTL_SD_DIR") or cp.get("defaults", "sd_dir", fallback=f"{HOME}/.local/share/stable-diffusion/models"))
        for sec in cp.sections():
            if not sec.startswith("sd:"):
                continue
            c = cp[sec]; mid = sec[3:].strip()
            print("|".join([mid, c.get("label", mid), c.get("note", ""), c.get("peak", "8000"), c.get("steps", "20"),
                            c.get("cfg", "7.0"), c.get("res", "512"), c.get("args", "").replace("$SD", sd)]))
        return
    if cmd == "image":
        sd = os.environ.get("MODELCTL_SD_DIR", cp.get("defaults", "sd_dir", fallback=f"{HOME}/.local/share/stable-diffusion/models"))
        ck = cp.get("defaults", "sd_server_model", fallback="sd_turbo.safetensors")
        os.execvp("sd-server", ["sd-server", "-m", os.path.join(os.path.expanduser(sd), ck), "--type", "f16",
                                "--listen-ip", "127.0.0.1", "--listen-port", os.environ.get("MODELCTL_SD_PORT", "8091")] + argv[1:])
    models = discover(cp)
    if cmd == "list":
        if not models:
            sys.exit("modelctl: no .gguf files under " + ":".join(DIRS) + " (set MODELCTL_MODEL_DIRS)")
        if "--tsv" in argv:
            for m in models:
                print("\t".join([m["id"], m["label"], m["tag"], str(m["ctx"]), m["note"], m["path"],
                                 "1" if m["mmproj"] else "0"]))
            return
        print(f"{'ID':40} {'CTX':>7}  {'VIS':3} NOTE")
        for m in models:
            print(f"{m['id']:40} {m['ctx']:>7}  {'yes' if m['mmproj'] else '':3} {m['note']}")
        print(f"\nconfig: {CONF}   port: {PORT}   dirs: {':'.join(DIRS)}")
        return
    if cmd in ("-h", "--help", "help"):
        print(__doc__.strip()); return
    if cmd == "show":
        print(shlex.join(cmdline(models[0] if argv[1:2] in ([], ["default"]) else find(models, argv[1]))))
        return
    if not models:
        sys.exit("modelctl: no models found (see: modelctl list)")
    m = models[0] if cmd == "default" else find(models, cmd)
    if not os.path.exists(m["path"]):
        sys.exit(f"modelctl: {m['path']} vanished — is the model partition mounted?")
    c = cmdline(m) + argv[1:]
    print("modelctl:", shlex.join(c), file=sys.stderr, flush=True)
    os.execvp(c[0], c)


if __name__ == "__main__":
    main(sys.argv[1:])
