{
  "schemaVersion": 1,
  "id": "tjcelaya.modelctl",
  "name": "modelctl",
  "version": "0.1.1",
  "author": "tjcelaya",
  "license": "MIT",
  "description": "Local llama.cpp and stable-diffusion.cpp model control plus a live coding-agent list, as three dropdowns in the Omarchy bar.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "modelctl",
    "description": "Segments for the running coding agents, the loaded local model and the image model. Left click opens that group, middle click opens all, right click opens the group's actions.",
    "category": "AI",
    "allowMultiple": false,
    "defaultSection": "center",
    "defaults": {
      "refreshIntervalSec": 5,
      "port": 8090,
      "showCwd": true,
      "imageDir": "~/Pictures/generated",
      "agentsIcon": "󰙴",
      "modelIcon": "󰧑",
      "order": "agents,model,image"
    },
    "schema": [
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 2,
        "max": 120,
        "step": 1,
        "defaultValue": 5
      },
      {
        "key": "port",
        "type": "integer",
        "label": "llama-server port",
        "min": 1024,
        "max": 65535,
        "step": 1,
        "defaultValue": 8090
      },
      {
        "key": "showCwd",
        "type": "boolean",
        "label": "Show agent working directory",
        "defaultValue": true
      },
      {
        "key": "imageDir",
        "type": "string",
        "label": "Generated image folder",
        "defaultValue": "~/Pictures/generated"
      },
      {
        "key": "order",
        "type": "string",
        "label": "Groups shown, left to right: agents (always), model, image",
        "defaultValue": "agents,model,image"
      },
      {
        "key": "agentsIcon",
        "type": "string",
        "label": "Agents badge glyph (suggestions: 󰆍 console, 󰞷 >_,  agent, 󱚣 robot)",
        "defaultValue": "󰙴"
      },
      {
        "key": "modelIcon",
        "type": "string",
        "label": "Model glyph (suggestions: 󰚩 robot, 󰘚 chip, 󰻠 cpu, 󰍛 memory)",
        "defaultValue": "󰧑"
      }
    ]
  }
}
