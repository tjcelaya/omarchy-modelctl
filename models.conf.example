# ~/.config/modelctl/models.conf — everything machine- or model-specific for modelctl.
# Models themselves are discovered from disk (MODELCTL_MODEL_DIRS); this file only
# tunes them. Section names are globs matched against the model id (the GGUF
# filename without .gguf); later matching sections override earlier ones.
#
# Keys:  ctx    context size passed as -c (default 16384)
#        args   the full llama-server flag set (replaces the default:
#               "-ngl 99 -fa on -np 1 --cache-reuse 256 --jinja")
#        extra  flags appended to args (use this for per-model additions)
#        label  the alias llama-server reports (-a); default = id minus quant suffix.
#               opencode's model list must match this.
#        tag    ≤5-char text shown next to the bar icon (default: derived from label)
#        note   one line for the menu description / `modelctl list`
#        mmproj vision projector path (default: an mmproj-*.gguf in the same folder)
# [defaults]-only keys for image generation:
#        sd_dir          checkpoint folder for modelctl-image / sd-server
#        sd_server_model checkpoint the resident sd-server loads
#        sd_check        true -> `modelctl-image --check <id>` smoke-tests a model and
#                        records wall time / peak GPU use / failure class (default false)
#        sd_retry_no_fa  true -> if the GPU hangs (Vulkan device lost) mid-generation,
#                        retry once without --diffusion-fa (default false)

[defaults]
default = gpt-oss-20b*
# hide = Qwen2.5-0.5B* *test*
# Measured on a Radeon 760M with a 23.5 GiB Vulkan pool (see TUNING.md): q8 KV cache
# lets a 20B model run at full 131k context. Drop -ctk/-ctv on a dGPU with room.
args = -ngl 99 -fa on -ctk q8_0 -ctv q8_0 -np 1 --cache-reuse 256 --jinja
sd_dir = ~/.local/share/stable-diffusion/models
sd_server_model = sd_turbo.safetensors
# sd_check = true
# sd_retry_no_fa = true

[gpt-oss-20b*]
ctx = 131072
label = gpt-oss-20b
tag = oss20
note = fastest here · 13.7 GiB OS free

[Qwen3-Coder-30B*]
ctx = 16384
label = qwen3-coder-30b
tag = qc30
note = 2.5x slower prefill · 8.7 GiB free

[gemma-4-12B-it-QAT*]
ctx = 16384
label = gemma-4-12b
tag = g12
note = ~35s per image query

[Qwen3-4B*]
ctx = 32768
label = qwen3-4b
tag = q4
note = 29 tok/s · quick chat

# ── image models ──────────────────────────────────────────────────────────────
# One [sd:<id>] section per checkpoint for modelctl-image; the id is what the menu
# and `modelctl-image --<id>` use. `$SD` in args expands to sd_dir. Keys:
#   label  menu label            note   short menu description
#   peak   nominal peak GPU MiB (parks the running LLM if it would not fit; replaced by
#          a native-res `modelctl-image --check <id> --full` on your machine)
#   steps / cfg / res   defaults for --steps, --cfg-scale and -W/-H
#   args   everything else sd-cli needs (checkpoint, VAE, text encoders, flags)
# Delete the ones you do not have; peaks below are rough placeholders, not measurements.

[sd:turbo]
label = · Turbo
note = 512² · 4 steps · drafts
peak = 4500
steps = 4
cfg = 1.0
res = 512
args = -m $SD/sd_turbo.safetensors --type f16

[sd:sd15]
label = · SD 1.5
note = 512² · 20 steps · steers harder
peak = 4000
steps = 20
cfg = 7.0
res = 512
args = -m $SD/v1-5-pruned-emaonly-fp16.safetensors --type f16

[sd:sdxl]
label = · SDXL-Lightning
note = 1024² · 4 steps
peak = 7600
steps = 4
cfg = 1.0
res = 1024
args = -m $SD/sdxl_lightning_4step.safetensors --vae $SD/sdxl_vae_fp16_fix.safetensors --sampling-method euler --scheduler sgm_uniform --diffusion-fa --vae-tiling

[sd:zimage]
label = · Z-Image-Turbo
note = 1024² · 8 steps · Qwen3-4B text encoder
peak = 11600
steps = 8
cfg = 1.0
res = 1024
args = --diffusion-model $SD/z_image_turbo-Q8_0.gguf --vae $SD/flux_ae.safetensors --llm $SD/Qwen3-4B-Instruct-2507-Q8_0.gguf --diffusion-fa --vae-tiling

[sd:flux]
label = · Flux.1-schnell
note = 1024² · 4 steps · T5-XXL text encoder
peak = 18600
steps = 4
cfg = 1.0
res = 1024
args = --diffusion-model $SD/flux1-schnell-Q8_0.gguf --vae $SD/flux_ae.safetensors --clip_l $SD/clip_l.safetensors --t5xxl $SD/t5-v1_1-xxl-encoder-Q8_0.gguf --diffusion-fa --vae-tiling

[sd:chroma]
label = · Chroma1-HD
note = 1024² · 20 steps · T5-XXL text encoder
peak = 15600
steps = 20
cfg = 4.0
res = 1024
args = --diffusion-model $SD/Chroma1-HD-Q8_0.gguf --vae $SD/flux_ae.safetensors --t5xxl $SD/t5-v1_1-xxl-encoder-Q8_0.gguf --sampling-method euler --diffusion-fa --vae-tiling
